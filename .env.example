# Database
DATABASE_URL=postgres://harness:harness@localhost:5432/bevox_harness

# Redis
REDIS_URL=redis://localhost:6379

# Bevox callbacks
BEVOX_CALLBACK_BASE_URL=http://localhost:3000
BEVOX_DB_URL=postgres://bevox:bevox@127.0.0.1:5432/bevox

# Calendar service
CALENDAR_SERVICE_URL=http://localhost:3009/api

# LLM
OPENAI_API_KEY=sk-...
# OPENAI_API_KEYS=sk-...,sk-...
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
DEFAULT_LLM_PROVIDER=openai
DEFAULT_LLM_MODEL=gpt-4o-mini

# Harness
HARNESS_QUEUE_NAME=bevox.execution.dispatch
HARNESS_MAX_EXECUTION_TIME_MS=90000
HARNESS_LOG_LEVEL=info

# Observability (Phase 4)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318/v1/traces
OTEL_SERVICE_NAME=bevox-agent-harness

# === MCP Server (Sprint B.1 — optional, only used by `bevox-mcp` binary) ===
# Transport: stdio (Claude Desktop spawn) or sse (remote bearer-authed).
MCP_TRANSPORT=stdio
# Whitelist of skill ids to expose (csv glob over `${category}.${name}`).
# Empty value or unset = fail-closed (no skills exposed).
MCP_EXPOSED_SKILLS=knowledge.*
# Extra runtime-denied skills (csv of bare names) merged into the synthetic
# external agent's denied list, on top of stop-signal and write-* defaults.
MCP_DENIED_SKILLS=
# Bearer token required for SSE transport. Generate with: openssl rand -hex 32
MCP_SERVER_TOKEN=
MCP_SSE_HOST=127.0.0.1
MCP_SSE_PORT=7071
# Account id used as the `accountId` field on the synthetic execution context
# of MCP-originated tool calls. Set to the account whose data MCP clients see.
BEVOX_DEFAULT_ACCOUNT_ID=

# === MCP Client (Sprint B.2 — optional, consume external MCP servers as skills) ===
MCP_CLIENT_ENABLED=false
MCP_SERVERS_CONFIG_PATH=./mcp.config.json
MCP_CLIENT_TIMEOUT_MS=10000
# true = fail bootstrap if any configured MCP server is unreachable
MCP_REQUIRE_ALL=false
